# ---- Supabase (obrigatório) ----
NEXT_PUBLIC_SUPABASE_URL=https://xsxliznkbqgabcdwohgx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MPGBfn_76-iN_mXCF6dXiw_gLZkNgMg
# A ANON KEY em formato JWT (necessária para supabase-js)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A SERVICE ROLE KEY — NUNCA commitar. Apenas para scripts de seed/migration.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Geocodificação ----
# Google Maps (preferencial)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Fallback: OpenStreetMap Nominatim (sem chave necessária)

# ---- Busca Automatizada ----
# SerpAPI (Google Search programático)
SEARCH_API_KEY=
# Firecrawl (extração de conteúdo de páginas web)
FIRECRAWL_API_KEY=
# Apify (automação de web scraping)
APIFY_API_TOKEN=
# Browserless (navegador headless)
BROWSERLESS_API_KEY=

# ---- IA / LLM (para extração inteligente de anúncios) ----
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# ---- Ambiente ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
